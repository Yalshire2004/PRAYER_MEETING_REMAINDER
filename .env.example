# America/New_York keeps "Monday morning" and Thursday 5 AM aligned with the group.
TZ=America/New_York

# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# then use smtp.gmail.com / 587 / your Gmail address / the 16-character app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yalshire2004@gmail.com
SMTP_PASS=
SMTP_FROM=Prayer Recorder <yalshire2004@gmail.com>

# Optional. Protects POST /api/remind if you also deploy the web service.
CRON_SECRET=

# Set to 1 to print the email instead of sending it.
DRY_RUN=0
PORT=3000
